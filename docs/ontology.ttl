<https://w3id.org/mod#status> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/medical-device-catalogPEC2#addressesIncident
:addressesIncident rdf:type owl:ObjectProperty ;
                   rdfs:domain :CorrectiveAction ;
                   rdfs:range :Incident ;
                   rdfs:comment "Links a corrective action with its incident"@en ;
                   rdfs:label "addresses incident"@en .


###  https://w3id.org/medical-device-catalogPEC2#affectedDevice
:affectedDevice rdf:type owl:ObjectProperty ;
                rdfs:domain :Risk ;
                rdfs:range :Device ;
                rdfs:comment "Links a risk with the device"@en ;
                rdfs:label "affected device type"@en .


###  https://w3id.org/medical-device-catalogPEC2#affectsPatient
:affectsPatient rdf:type owl:ObjectProperty ;
                rdfs:domain :Incident ;
                rdfs:range :Patient ;
                rdfs:comment "Relates a reported incident to the specific patient affected by the event."@en ;
                rdfs:label "affects patient"@en .


###  https://w3id.org/medical-device-catalogPEC2#associatedRisk
:associatedRisk rdf:type owl:ObjectProperty ;
                rdfs:domain :Incident ;
                rdfs:range :Risk ;
                rdfs:comment "Links an incident with its risk"@en ;
                rdfs:label "associated risk"@en .


###  https://w3id.org/medical-device-catalogPEC2#hasManufacturer
:hasManufacturer rdf:type owl:ObjectProperty ;
                 rdfs:domain :Device ;
                 rdfs:range :Manufacturer ;
                 rdfs:comment "Links a device to its manufacturer"@en ;
                 rdfs:label "has manufacturer"@en .


###  https://w3id.org/medical-device-catalogPEC2#hasPart
:hasPart rdf:type owl:ObjectProperty ,
                  owl:TransitiveProperty ;
         rdfs:domain :Device ;
         rdfs:range :Device ;
         rdfs:comment "Inverse of isPartOf. Describes the components contained within a device."@en ;
         rdfs:label "has part"@en .


###  https://w3id.org/medical-device-catalogPEC2#hasReported
:hasReported rdf:type owl:ObjectProperty ;
             owl:inverseOf :reportedBy ;
             rdfs:domain :Manufacturer ;
             rdfs:range :Incident ;
             rdfs:comment "Inverse of reportedBy. Links a manufacturer to the incidents they have reported."@en ;
             rdfs:label "has reported"@en .


###  https://w3id.org/medical-device-catalogPEC2#hasRisk
:hasRisk rdf:type owl:ObjectProperty ;
         owl:inverseOf :affectedDevice ;
         rdfs:domain :Device ;
         rdfs:range :Risk ;
         rdfs:comment "Inverse of affectedDevice. Links a medical device to the risks associated with it."@en ;
         rdfs:label "has risk"@en .


###  https://w3id.org/medical-device-catalogPEC2#involvesDevice
:involvesDevice rdf:type owl:ObjectProperty ;
                rdfs:domain :Incident ;
                rdfs:range :Device ;
                rdfs:comment "Links an incident with its device"@en ;
                rdfs:label "involves device"@en .


###  https://w3id.org/medical-device-catalogPEC2#isAddressedBy
:isAddressedBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :addressesIncident ;
               rdfs:domain :Incident ;
               rdfs:range :CorrectiveAction ;
               rdfs:comment "Inverse of addressesIncident. Links an incident to the corrective action taken."@en ;
               rdfs:label "is addressed by"@en .


###  https://w3id.org/medical-device-catalogPEC2#isAffectedByIncident
:isAffectedByIncident rdf:type owl:ObjectProperty ;
                      owl:inverseOf :affectsPatient ;
                      rdfs:domain :Patient ;
                      rdfs:range :Incident ;
                      rdfs:comment "Inverse of affectsPatient. Links a patient to the incidents that have affected them."@en ;
                      rdfs:label "is affected by incident"@en .


###  https://w3id.org/medical-device-catalogPEC2#isPartOf
:isPartOf rdf:type owl:ObjectProperty ;
          owl:inverseOf :hasPart ;
          rdf:type owl:TransitiveProperty ;
          rdfs:domain :Device ;
          rdfs:range :Device ;
          rdfs:comment "Transitive property to describe components that are part of a larger medical system."@en ;
          rdfs:label "is part of"@en .


###  https://w3id.org/medical-device-catalogPEC2#isRiskOf
:isRiskOf rdf:type owl:ObjectProperty ;
          owl:inverseOf :associatedRisk ;
          rdfs:domain :Risk ;
          rdfs:range :Incident ;
          rdfs:comment "Inverse of associatedRisk. Links a risk to the incident it is associated with."@en ;
          rdfs:label "is risk of"@en .


###  https://w3id.org/medical-device-catalogPEC2#isSupervisedBy
:isSupervisedBy rdf:type owl:ObjectProperty ;
                rdfs:domain :Manufacturer ;
                rdfs:range :CompetentAuthority ;
                rdfs:comment "Links a manufacturer to the national competent authority responsible for its regulatory oversight."@en ;
                rdfs:label "is supervised by"@en .


###  https://w3id.org/medical-device-catalogPEC2#isUsedInIncident
:isUsedInIncident rdf:type owl:ObjectProperty ;
                  owl:inverseOf :involvesDevice ;
                  rdfs:domain :Device ;
                  rdfs:range :Incident ;
                  rdfs:comment "Inverse of involvesDevice. Links a device to the incidents it was involved in."@en ;
                  rdfs:label "is used in incident"@en .


###  https://w3id.org/medical-device-catalogPEC2#manufactures
:manufactures rdf:type owl:ObjectProperty ;
              owl:inverseOf :hasManufacturer ;
              rdfs:domain :Manufacturer ;
              rdfs:range :Device ;
              rdfs:comment "Inverse of hasManufacturer. Links a manufacturer to the devices it produces."@en ;
              rdfs:label "manufactures"@en .


###  https://w3id.org/medical-device-catalogPEC2#reportedBy
:reportedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Incident ;
            rdfs:range :Manufacturer ;
            rdfs:comment "Links an incident with its manufacturer"@en ;
            rdfs:label "reported by"@en .


###  https://w3id.org/medical-device-catalogPEC2#supervises
:supervises rdf:type owl:ObjectProperty ;
            owl:inverseOf :isSupervisedBy ;
            rdfs:domain :CompetentAuthority ;
            rdfs:range :Manufacturer ;
            rdfs:comment "Inverse of isSupervisedBy. Links a competent authority to the manufacturers it oversees."@en ;
            rdfs:label "supervises"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/medical-device-catalogPEC2#actionDate
:actionDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :CorrectiveAction ;
            rdfs:range xsd:date ;
            rdfs:comment "Date of the action"@en ;
            rdfs:label "action date"@en .


###  https://w3id.org/medical-device-catalogPEC2#actionType
:actionType rdf:type owl:DatatypeProperty ;
            rdfs:domain :CorrectiveAction ;
            rdfs:range xsd:string ;
            rdfs:comment "Type of action"@en ;
            rdfs:label "action type"@en .


###  https://w3id.org/medical-device-catalogPEC2#authorizationNumber
:authorizationNumber rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Manufacturer ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Number of the authorization"@en ;
                     rdfs:label "authorization number"@en .


###  https://w3id.org/medical-device-catalogPEC2#closureDate
:closureDate rdf:type owl:DatatypeProperty ;
             rdfs:domain :CorrectiveAction ;
             rdfs:range xsd:date ;
             rdfs:comment "Date of closure"@en ;
             rdfs:label "closure date"@en .


###  https://w3id.org/medical-device-catalogPEC2#competentAuthority
:competentAuthority rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Manufacturer ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Authority that certified the manufacturer"@en ;
                    rdfs:label "competent authority"@en .


###  https://w3id.org/medical-device-catalogPEC2#contactEmail
:contactEmail rdf:type owl:DatatypeProperty ;
              rdfs:domain :Manufacturer ;
              rdfs:range xsd:string ;
              rdfs:comment "Email of contact"@en ;
              rdfs:label "contact email"@en .


###  https://w3id.org/medical-device-catalogPEC2#correctiveActionTaken
:correctiveActionTaken rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Incident ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Corrective action taken for the incident"@en ;
                       rdfs:label "corrective action taken"@en .


###  https://w3id.org/medical-device-catalogPEC2#countriesAffected
:countriesAffected rdf:type owl:DatatypeProperty ;
                   rdfs:domain :CorrectiveAction ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Countries affected by the corrective actions"@en ;
                   rdfs:label "countries affected"@en .


###  https://w3id.org/medical-device-catalogPEC2#country
:country rdf:type owl:DatatypeProperty ;
         rdfs:domain :Participant ;
         rdfs:range xsd:string ;
         rdfs:comment "Name of the country"@en ;
         rdfs:label "country"@en .


###  https://w3id.org/medical-device-catalogPEC2#countryReported
:countryReported rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Incident ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Name of the country that reported the incident"@en ;
                 rdfs:label "country reported"@en .


###  https://w3id.org/medical-device-catalogPEC2#description
:description rdf:type owl:DatatypeProperty ;
             rdfs:domain :Risk ;
             rdfs:range xsd:string ;
             rdfs:comment "Description"@en ;
             rdfs:label "description"@en ,
                        "device" .


###  https://w3id.org/medical-device-catalogPEC2#detectionDate
:detectionDate rdf:type owl:DatatypeProperty ;
               rdfs:domain :Incident ;
               rdfs:range xsd:date ;
               rdfs:comment "The date that the incident was detected "@en ;
               rdfs:label "detection date"@en .


###  https://w3id.org/medical-device-catalogPEC2#deviceId
:deviceId rdf:type owl:DatatypeProperty ;
          rdfs:domain :Device ;
          rdfs:range xsd:string ;
          rdfs:comment "Id of the device"@en ;
          rdfs:label "device id"@en .


###  https://w3id.org/medical-device-catalogPEC2#deviceName
:deviceName rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:string ;
            rdfs:comment "Name of the device"@en ;
            rdfs:label "device name"@en .


###  https://w3id.org/medical-device-catalogPEC2#deviceType
:deviceType rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:string ;
            rdfs:comment "Type of the device"@en ;
            rdfs:label "device type"@en .


###  https://w3id.org/medical-device-catalogPEC2#devicesAffected
:devicesAffected rdf:type owl:DatatypeProperty ;
                 rdfs:domain :CorrectiveAction ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "Devices affected by the corrective action"@en ;
                 rdfs:label "devices affected"@en .


###  https://w3id.org/medical-device-catalogPEC2#eudamedFscaRef
:eudamedFscaRef rdf:type owl:DatatypeProperty ;
                rdfs:domain :CorrectiveAction ;
                rdfs:range xsd:string ;
                rdfs:comment "Referenci of the eumed fsca"@en ;
                rdfs:label "eudamed fsca ref"@en .


###  https://w3id.org/medical-device-catalogPEC2#eudamedIncidentRef
:eudamedIncidentRef rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Incident ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Reference of the incident in the eudamed"@en ;
                    rdfs:label "eudamed incident ref"@en .


###  https://w3id.org/medical-device-catalogPEC2#eudomedSrn
:eudomedSrn rdf:type owl:DatatypeProperty ;
            rdfs:domain :Manufacturer ;
            rdfs:range xsd:string ;
            rdfs:comment "The Single Registration Number assigned to the manufacturer in the EUDAMED"@en ;
            rdfs:label "eudomed srn"@en .


###  https://w3id.org/medical-device-catalogPEC2#eventDate
:eventDate rdf:type owl:DatatypeProperty ;
           rdfs:domain :Incident ;
           rdfs:range xsd:date ;
           rdfs:comment "Date of the event"@en ;
           rdfs:label "event date"@en .


###  https://w3id.org/medical-device-catalogPEC2#fscaId
:fscaId rdf:type owl:DatatypeProperty ;
        rdfs:domain :CorrectiveAction ;
        rdfs:range xsd:string ;
        rdfs:comment "Id of the FSCA"@en ;
        rdfs:label "fsca id"@en .


###  https://w3id.org/medical-device-catalogPEC2#highPriority
:highPriority rdf:type owl:DatatypeProperty ;
              rdfs:domain :Incident ;
              rdfs:range xsd:boolean ;
              rdfs:comment "High priority property."@en ;
              rdfs:label "High Priority"@en .


###  https://w3id.org/medical-device-catalogPEC2#imdrfCode
:imdrfCode rdf:type owl:DatatypeProperty ;
           rdfs:domain :Risk ;
           rdfs:range xsd:string ;
           rdfs:comment "Standardized adverse event terminology code"@en ;
           rdfs:label "imdrf code"@en .


###  https://w3id.org/medical-device-catalogPEC2#incidentId
:incidentId rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:string ;
            rdfs:comment "Incident identificator"@en ;
            rdfs:label "incident id"@en .


###  https://w3id.org/medical-device-catalogPEC2#incidentType
:incidentType rdf:type owl:DatatypeProperty ;
              rdfs:domain :Incident ;
              rdfs:range xsd:string ;
              rdfs:comment "Type of the incident"@en ;
              rdfs:label "incident type"@en .


###  https://w3id.org/medical-device-catalogPEC2#intendedPurpose
:intendedPurpose rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Device ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Purpose of the intended"@en ;
                 rdfs:label "intended purpose"@en .


###  https://w3id.org/medical-device-catalogPEC2#isActive
:isActive rdf:type owl:DatatypeProperty ;
          rdfs:domain :Device ;
          rdfs:range xsd:boolean ;
          rdfs:comment "Boolean if the device is active or not"@en ;
          rdfs:label "is active"@en .


###  https://w3id.org/medical-device-catalogPEC2#isCritical
:isCritical rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Is critical property"@en ;
            rdfs:label "Is Critical"@en .


###  https://w3id.org/medical-device-catalogPEC2#isImplantable
:isImplantable rdf:type owl:DatatypeProperty ;
               rdfs:domain :Device ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Boolean if the device is implantable or not"@en ;
               rdfs:label "is implantable"@en .


###  https://w3id.org/medical-device-catalogPEC2#isIvd
:isIvd rdf:type owl:DatatypeProperty ;
       rdfs:domain :Device ;
       rdfs:range xsd:boolean ;
       rdfs:comment "Boolean if the device is ivd or not"@en ;
       rdfs:label "is ivd"@en .


###  https://w3id.org/medical-device-catalogPEC2#isReusable
:isReusable rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Boolean if the device is reusable or not"@en ;
            rdfs:label "is reusable"@en .


###  https://w3id.org/medical-device-catalogPEC2#manufacturerId
:manufacturerId rdf:type owl:DatatypeProperty ;
                rdfs:domain :Manufacturer ;
                rdfs:range xsd:string ;
                rdfs:comment "Manufacturer identificator"@en ;
                rdfs:label "manufacturer id"@en .


###  https://w3id.org/medical-device-catalogPEC2#name
:name rdf:type owl:DatatypeProperty ;
      rdfs:domain :Participant ;
      rdfs:range xsd:string ;
      rdfs:comment "Name of the manufacturer"@en ;
      rdfs:label "name"@en .


###  https://w3id.org/medical-device-catalogPEC2#outcome
:outcome rdf:type owl:DatatypeProperty ;
         rdfs:domain :Incident ;
         rdfs:range xsd:string ;
         rdfs:comment "Outcome of the incident"@en ;
         rdfs:label "outcome"@en .


###  https://w3id.org/medical-device-catalogPEC2#patientAge
:patientAge rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:integer ;
            rdfs:comment "Age of the patient"@en ;
            rdfs:label "patient age"@en .


###  https://w3id.org/medical-device-catalogPEC2#patientSex
:patientSex rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:string ;
            rdfs:comment "Sex of the pationt"@en ;
            rdfs:label "patient sex"@en .


###  https://w3id.org/medical-device-catalogPEC2#probability
:probability rdf:type owl:DatatypeProperty ;
             rdfs:domain :Risk ;
             rdfs:range xsd:string ;
             rdfs:comment "Probability of the risk"@en ;
             rdfs:label "probability"@en .


###  https://w3id.org/medical-device-catalogPEC2#regulatoryFramework
:regulatoryFramework rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Device ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Legal framework for the device"@en ;
                     rdfs:label "regulatory framework"@en .


###  https://w3id.org/medical-device-catalogPEC2#reportDate
:reportDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:date ;
            rdfs:comment "Date when the incident was reported"@en ;
            rdfs:label "report date"@en .


###  https://w3id.org/medical-device-catalogPEC2#riskCategory
:riskCategory rdf:type owl:DatatypeProperty ;
              rdfs:domain :Risk ;
              rdfs:range xsd:string ;
              rdfs:comment "Category of the risk"@en ;
              rdfs:label "risk category"@en .


###  https://w3id.org/medical-device-catalogPEC2#riskClass
:riskClass rdf:type owl:DatatypeProperty ;
           rdfs:domain :Device ;
           rdfs:range xsd:string ;
           rdfs:comment "Class of the risk"@en ;
           rdfs:label "risk class"@en .


###  https://w3id.org/medical-device-catalogPEC2#riskId
:riskId rdf:type owl:DatatypeProperty ;
        rdfs:domain :Risk ;
        rdfs:range xsd:string ;
        rdfs:comment "Risk identificator"@en ;
        rdfs:label "risk id"@en .


###  https://w3id.org/medical-device-catalogPEC2#riskName
:riskName rdf:type owl:DatatypeProperty ;
          rdfs:domain :Risk ;
          rdfs:range xsd:string ;
          rdfs:comment "Name of the risk"@en ;
          rdfs:label "risk name"@en .


###  https://w3id.org/medical-device-catalogPEC2#riskType
:riskType rdf:type owl:DatatypeProperty ;
          rdfs:domain :Risk ;
          rdfs:range xsd:string ;
          rdfs:comment "Type of the risk"@en ;
          rdfs:label "risk type"@en .


###  https://w3id.org/medical-device-catalogPEC2#scope
:scope rdf:type owl:DatatypeProperty ;
       rdfs:domain :CorrectiveAction ;
       rdfs:range xsd:string ;
       rdfs:comment "Scope of action "@en ;
       rdfs:label "scope"@en .


###  https://w3id.org/medical-device-catalogPEC2#severity
:severity rdf:type owl:DatatypeProperty ;
          rdfs:domain :Risk ;
          rdfs:range xsd:string ;
          rdfs:comment "Severity of the risk"@en ;
          rdfs:label "severity"@en .


###  https://w3id.org/medical-device-catalogPEC2#status
:status rdf:type owl:DatatypeProperty ;
        rdfs:domain :CorrectiveAction ;
        rdfs:range xsd:string ;
        rdfs:comment "Information about the status of the corrective action"@en ;
        rdfs:label "status"@en .


###  https://w3id.org/medical-device-catalogPEC2#udiDi
:udiDi rdf:type owl:DatatypeProperty ;
       rdfs:domain :Device ;
       rdfs:range xsd:string ;
       rdfs:comment "Device Identifier"@en ;
       rdfs:label "udi di"@en .


