@prefix : <https://w3id.org/medical-device-catalogPEC2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/medical-device-catalogPEC2#> .

<https://w3id.org/medical-device-catalogPEC2#> rdf:type owl:Ontology ;
                                                owl:versionIRI <https://w3id.org/medical-device-catalogPEC2/1.0.0#> ;
                                                <http://purl.org/dc/elements/1.1/title> "European Medical Device Catalog Ontology (MDR/IVDR)"@en ;
                                                <http://purl.org/dc/terms/abstract> "Comprehensive semantic model for the European catalog of medical devices under the MDR and IVDR regulations."@en ;
                                                <http://purl.org/dc/terms/bibliographicCitation> "Regueiro Janeiro, J. A. (2026). European Medical Device Catalog Ontology (MDR/IVDR). Version 1.0." ;
                                                <http://purl.org/dc/terms/created> "2026-04-03"^^xsd:date ;
                                                <http://purl.org/dc/terms/creator> "Jose Angel Regueiro Janeiro" ;
                                                <http://purl.org/dc/terms/description> "This ontology represents the European catalog of high-risk medical devices, including manufacturers, incidents, and corrective actions."@en ;
                                                <http://purl.org/dc/terms/identifier> "https://doi.org/10.5281/zenodo.1000001" ;
                                                <http://purl.org/dc/terms/issued> "2026-04-05"^^xsd:date ;
                                                <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                <http://purl.org/dc/terms/modified> "2026-04-05"^^xsd:date ;
                                                <http://purl.org/dc/terms/publisher> <https://github.com/joregueiro> ;
                                                <http://purl.org/dc/terms/source> <https://github.com/joregueiro/OntologyPEC2> ;
                                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "ns" ;
                                                <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/medical-device-catalogPEC2#" ;
                                                rdfs:comment "Ontology for the European catalog of medical devices (MDR/IVDR)."@en ;
                                                owl:backwardCompatibleWith <https://w3id.org/medical-device-catalogPEC2/0.9.0#> ;
                                                owl:versionInfo "1.0" ;
                                                <http://xmlns.com/foaf/0.1/logo> <https://joregueiro.github.io/OntologyPEC2/logo.png> ;
                                                <https://w3id.org/mod#createdWith> <https://chowlk.linkeddata.es/> ;
                                                <https://w3id.org/mod#status> "Stable" .

