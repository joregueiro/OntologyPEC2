#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :ClassA
                :ClassB
                :ClassC
                :ClassD
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :ClassI
                :ClassIII
                :ClassIIa
                :ClassIIb
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :CompetentAuthority
                :Manufacturer
                :Patient
              )
] .


