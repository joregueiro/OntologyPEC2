        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Reference of the incident in the eudamed</rdfs:comment>
        <rdfs:label xml:lang="en">eudamed_incident_ref</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#eudomedSrn -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#eudomedSrn">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Eudomed srn</rdfs:comment>
        <rdfs:label xml:lang="en">eudomed_srn</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#eventDate -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#eventDate">
