<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.owl-ontologies.com/ns#"
     xml:base="http://www.owl-ontologies.com/ns"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.owl-ontologies.com/ns#"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.owl-ontologies.com/ns#">
        <dc:title xml:lang="en">European Medical Device Catalog Ontology (MDR/IVDR)</dc:title>
        <terms:abstract xml:lang="en">Comprehensive semantic model for the European catalog of medical devices under the MDR and IVDR regulations.</terms:abstract>
        <terms:creator>Jose Angel Regueiro Janeiro</terms:creator>
        <terms:description xml:lang="en">This ontology represents the European catalog of high-risk medical devices, including manufacturers, incidents, and corrective actions.</terms:description>
        <rdfs:comment xml:lang="en">Ontology for the European catalog of medical devices (MDR/IVDR).</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
        <mod:createdWith rdf:resource="https://chowlk.linkeddata.es/"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- https://w3id.org/mod#createdWith -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mod#createdWith"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.owl-ontologies.com/ns#addressesIncident -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/ns#addressesIncident">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/ns#Incident"/>
        <rdfs:comment xml:lang="en">Links a corrective action with its incident</rdfs:comment>
        <rdfs:label xml:lang="en">addresses incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/ns#affectedDevice -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/ns#affectedDevice">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Risk"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/ns#Device"/>
        <rdfs:comment xml:lang="en">Links a risk with the device</rdfs:comment>
        <rdfs:label xml:lang="en">affected device type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/ns#affectsPatient -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/ns#affectsPatient">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Incident"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/ns#Patient"/>
        <rdfs:label xml:lang="en">affects patient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/ns#associatedRisk -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/ns#associatedRisk">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Incident"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/ns#Risk"/>
        <rdfs:comment xml:lang="en">Links an incident with its risk</rdfs:comment>
        <rdfs:label xml:lang="en">associated risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/ns#hasManufacturer -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/ns#hasManufacturer">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Device"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/ns#Manufacturer"/>
        <rdfs:comment xml:lang="en">Links a device to its manufacturer</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/ns#involvesDevice -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/ns#involvesDevice">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Incident"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/ns#Device"/>
        <rdfs:comment xml:lang="en">Links an incident with its device</rdfs:comment>
        <rdfs:label xml:lang="en">involves device</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/ns#isSupervisedBy -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/ns#isSupervisedBy">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/ns#CompetentAuthority"/>
        <rdfs:label xml:lang="en">is supervised by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/ns#reportedBy -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/ns#reportedBy">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Incident"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/ns#Manufacturer"/>
        <rdfs:comment xml:lang="en">Links an incident with its manufacturer</rdfs:comment>
        <rdfs:label xml:lang="en">reported by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.owl-ontologies.com/ns#actionDate -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#actionDate">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date of the action</rdfs:comment>
        <rdfs:label xml:lang="en">action_date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#actionType -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#actionType">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Type of action</rdfs:comment>
        <rdfs:label xml:lang="en">action_type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#authorizationNumber -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#authorizationNumber">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Number of the authorization</rdfs:comment>
        <rdfs:label xml:lang="en">authorization_number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#closureDate -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#closureDate">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date of closure</rdfs:comment>
        <rdfs:label xml:lang="en">closure_date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#competentAuthority -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#competentAuthority">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Authority that certified the manufacturer</rdfs:comment>
        <rdfs:label xml:lang="en">competent_authority</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#contactEmail -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#contactEmail">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Email of contact</rdfs:comment>
        <rdfs:label xml:lang="en">contact_email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#correctiveAction_taken -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#correctiveAction_taken">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Corrective action taken for the incident</rdfs:comment>
        <rdfs:label xml:lang="en">corrective_action_taken</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#countriesAffected -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#countriesAffected">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Countries affected by the corrective actions</rdfs:comment>
        <rdfs:label xml:lang="en">countries_affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#country -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#country">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the country</rdfs:comment>
        <rdfs:label xml:lang="en">country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#countryReported -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#countryReported">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the country that reported the incident</rdfs:comment>
        <rdfs:label xml:lang="en">country_reported</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#description -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#description">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Description</rdfs:comment>
        <rdfs:label xml:lang="en">description</rdfs:label>
        <rdfs:label>device</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#detectionDate -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#detectionDate">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The date that the incident was detected </rdfs:comment>
        <rdfs:label xml:lang="en">detection_date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#deviceId -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#deviceId">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Id of the device</rdfs:comment>
        <rdfs:label xml:lang="en">device_id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#deviceName -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#deviceName">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the device</rdfs:comment>
        <rdfs:label xml:lang="en">device_name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#deviceType -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#deviceType">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Type of the device</rdfs:comment>
        <rdfs:label xml:lang="en">device_type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#devicesAffected -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#devicesAffected">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Devices affected by the corrective action</rdfs:comment>
        <rdfs:label xml:lang="en">devices_affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#eudamedFsca_ref -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#eudamedFsca_ref">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Referenci of the eumed fsca</rdfs:comment>
        <rdfs:label xml:lang="en">eudamed_fsca_ref</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#eudamedIncident_ref -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#eudamedIncident_ref">
