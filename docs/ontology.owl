        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Outcome of the incident</rdfs:comment>
        <rdfs:label xml:lang="en">outcome</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#patientAge -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#patientAge">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Incident"/>
