    <owl:AnnotationProperty rdf:about="https://w3id.org/mod#status"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/medical-device-catalogPEC2#addressesIncident -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#addressesIncident">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#CorrectiveAction"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:comment xml:lang="en">Links a corrective action with its incident</rdfs:comment>
        <rdfs:label xml:lang="en">addresses incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#affectedDevice -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#affectedDevice">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Risk"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Device"/>
        <rdfs:comment xml:lang="en">Links a risk with the device</rdfs:comment>
        <rdfs:label xml:lang="en">affected device type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#affectsPatient -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#affectsPatient">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Patient"/>
        <rdfs:comment xml:lang="en">Relates a reported incident to the specific patient affected by the event.</rdfs:comment>
        <rdfs:label xml:lang="en">affects patient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#associatedRisk -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#associatedRisk">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Risk"/>
        <rdfs:comment xml:lang="en">Links an incident with its risk</rdfs:comment>
        <rdfs:label xml:lang="en">associated risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#hasManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#hasManufacturer">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Device"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Manufacturer"/>
        <rdfs:comment xml:lang="en">Links a device to its manufacturer</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#hasReported -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#hasReported">
        <owl:inverseOf rdf:resource="https://w3id.org/medical-device-catalogPEC2#reportedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Manufacturer"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:comment xml:lang="en">Inverse of reportedBy. Links a manufacturer to the incidents they have reported.</rdfs:comment>
        <rdfs:label xml:lang="en">has reported</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#hasRisk -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#hasRisk">
        <owl:inverseOf rdf:resource="https://w3id.org/medical-device-catalogPEC2#affectedDevice"/>
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Device"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Risk"/>
        <rdfs:comment xml:lang="en">Inverse of affectedDevice. Links a medical device to the risks associated with it.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#involvesDevice -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#involvesDevice">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Device"/>
        <rdfs:comment xml:lang="en">Links an incident with its device</rdfs:comment>
        <rdfs:label xml:lang="en">involves device</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#isAddressedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#isAddressedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/medical-device-catalogPEC2#addressesIncident"/>
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">Inverse of addressesIncident. Links an incident to the corrective action taken.</rdfs:comment>
        <rdfs:label xml:lang="en">is addressed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#isAffectedByIncident -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#isAffectedByIncident">
        <owl:inverseOf rdf:resource="https://w3id.org/medical-device-catalogPEC2#affectsPatient"/>
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Patient"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:comment xml:lang="en">Inverse of affectsPatient. Links a patient to the incidents that have affected them.</rdfs:comment>
        <rdfs:label xml:lang="en">is affected by incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#isRiskOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#isRiskOf">
        <owl:inverseOf rdf:resource="https://w3id.org/medical-device-catalogPEC2#associatedRisk"/>
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Risk"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:comment xml:lang="en">Inverse of associatedRisk. Links a risk to the incident it is associated with.</rdfs:comment>
        <rdfs:label xml:lang="en">is risk of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#isSupervisedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#isSupervisedBy">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Manufacturer"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#CompetentAuthority"/>
        <rdfs:comment xml:lang="en">Links a manufacturer to the national competent authority responsible for its regulatory oversight.</rdfs:comment>
        <rdfs:label xml:lang="en">is supervised by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#isUsedInIncident -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#isUsedInIncident">
        <owl:inverseOf rdf:resource="https://w3id.org/medical-device-catalogPEC2#involvesDevice"/>
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Device"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:comment xml:lang="en">Inverse of involvesDevice. Links a device to the incidents it was involved in.</rdfs:comment>
        <rdfs:label xml:lang="en">is used in incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#manufactures -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#manufactures">
        <owl:inverseOf rdf:resource="https://w3id.org/medical-device-catalogPEC2#hasManufacturer"/>
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Manufacturer"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Device"/>
        <rdfs:comment xml:lang="en">Inverse of hasManufacturer. Links a manufacturer to the devices it produces.</rdfs:comment>
        <rdfs:label xml:lang="en">manufactures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#reportedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#reportedBy">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Manufacturer"/>
        <rdfs:comment xml:lang="en">Links an incident with its manufacturer</rdfs:comment>
        <rdfs:label xml:lang="en">reported by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#supervises -->


    <owl:ObjectProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#supervises">
        <owl:inverseOf rdf:resource="https://w3id.org/medical-device-catalogPEC2#isSupervisedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#CompetentAuthority"/>
        <rdfs:range rdf:resource="https://w3id.org/medical-device-catalogPEC2#Manufacturer"/>
        <rdfs:comment xml:lang="en">Inverse of isSupervisedBy. Links a competent authority to the manufacturers it oversees.</rdfs:comment>
        <rdfs:label xml:lang="en">supervises</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/medical-device-catalogPEC2#actionDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#actionDate">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date of the action</rdfs:comment>
        <rdfs:label xml:lang="en">action date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#actionType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#actionType">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Type of action</rdfs:comment>
        <rdfs:label xml:lang="en">action type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#authorizationNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#authorizationNumber">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Number of the authorization</rdfs:comment>
        <rdfs:label xml:lang="en">authorization number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#closureDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#closureDate">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date of closure</rdfs:comment>
        <rdfs:label xml:lang="en">closure date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#competentAuthority -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#competentAuthority">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Authority that certified the manufacturer</rdfs:comment>
        <rdfs:label xml:lang="en">competent authority</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#contactEmail -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#contactEmail">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Email of contact</rdfs:comment>
        <rdfs:label xml:lang="en">contact email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#correctiveActionTaken -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#correctiveActionTaken">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Corrective action taken for the incident</rdfs:comment>
        <rdfs:label xml:lang="en">corrective action taken</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#countriesAffected -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#countriesAffected">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Countries affected by the corrective actions</rdfs:comment>
        <rdfs:label xml:lang="en">countries affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#country -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#country">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Participant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the country</rdfs:comment>
        <rdfs:label xml:lang="en">country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#countryReported -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#countryReported">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the country that reported the incident</rdfs:comment>
        <rdfs:label xml:lang="en">country reported</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#description -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#description">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Description</rdfs:comment>
        <rdfs:label xml:lang="en">description</rdfs:label>
        <rdfs:label>device</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#detectionDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#detectionDate">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The date that the incident was detected </rdfs:comment>
        <rdfs:label xml:lang="en">detection date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#deviceId -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#deviceId">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Id of the device</rdfs:comment>
        <rdfs:label xml:lang="en">device id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#deviceName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#deviceName">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the device</rdfs:comment>
        <rdfs:label xml:lang="en">device name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/medical-device-catalogPEC2#deviceType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/medical-device-catalogPEC2#deviceType">
        <rdfs:domain rdf:resource="https://w3id.org/medical-device-catalogPEC2#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Type of the device</rdfs:comment>
        <rdfs:label xml:lang="en">device type</rdfs:label>
