        <rdfs:label xml:lang="en">Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/ns#SafetyAlert -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/ns#SafetyAlert">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/ns#CorrectiveAction"/>
