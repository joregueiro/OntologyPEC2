<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/medical-device-catalogPEC2#"
     xml:base="https://w3id.org/medical-device-catalogPEC2"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:medical-device-catalogPEC2="https://w3id.org/medical-device-catalogPEC2#">
    <owl:Ontology rdf:about="https://w3id.org/medical-device-catalogPEC2#">
        <owl:versionIRI rdf:resource="https://w3id.org/medical-device-catalogPEC2/1.0.0#"/>
        <dc:title xml:lang="en">European Medical Device Catalog Ontology (MDR/IVDR)</dc:title>
        <terms:abstract xml:lang="en">Comprehensive semantic model for the European catalog of medical devices under the MDR and IVDR regulations.</terms:abstract>
        <terms:bibliographicCitation>Regueiro Janeiro, J. A. (2026). European Medical Device Catalog Ontology (MDR/IVDR). Version 1.0.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-03</terms:created>
        <terms:creator>Jose Angel Regueiro Janeiro</terms:creator>
        <terms:description xml:lang="en">This ontology represents the European catalog of high-risk medical devices, including manufacturers, incidents, and corrective actions.</terms:description>
        <terms:identifier>https://doi.org/10.5281/zenodo.1000001</terms:identifier>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-05</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-05</terms:modified>
        <terms:publisher rdf:resource="https://github.com/joregueiro"/>
        <terms:source rdf:resource="https://github.com/joregueiro/OntologyPEC2"/>
        <vann:preferredNamespacePrefix>ns</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/medical-device-catalogPEC2#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Ontology for the European catalog of medical devices (MDR/IVDR).</rdfs:comment>
        <owl:backwardCompatibleWith rdf:resource="https://w3id.org/medical-device-catalog/0.9.0#"/>
        <owl:versionInfo>1.0</owl:versionInfo>
        <foaf:logo rdf:resource="https://joregueiro.github.io/OntologyPEC2/logo.png"/>
        <mod:createdWith rdf:resource="https://chowlk.linkeddata.es/"/>
        <mod:status>Stable</mod:status>
    </owl:Ontology>
    


