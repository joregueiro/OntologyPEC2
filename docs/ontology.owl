        <name xml:lang="en">Medtronic plc</name>
        <rdfs:comment xml:lang="en">Manufacturer individual</rdfs:comment>
        <rdfs:label xml:lang="en">Medtronic plc</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/ns#RSK-018 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/ns#RSK-018">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/ns#CybersecurityRisk"/>
        <riskName xml:lang="en">Cybersecurity vulnerability</riskName>
        <rdfs:comment xml:lang="en">Vulnerability risk for digital devices</rdfs:comment>
        <rdfs:label xml:lang="en">Cybersecurity Risk 018</rdfs:label>
