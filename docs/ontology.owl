        <rdfs:label xml:lang="en">report_date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#riskCategory -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#riskCategory">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Category of the risk</rdfs:comment>
        <rdfs:label xml:lang="en">risk_category</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#riskClass -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#riskClass">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Class of the risk</rdfs:comment>
        <rdfs:label xml:lang="en">risk_class</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#riskId -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#riskId">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/ns#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Risk identificator</rdfs:comment>
        <rdfs:label xml:lang="en">risk_id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#riskName -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#riskName">
