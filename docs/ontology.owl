        <rdfs:label xml:lang="en">Germany</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/ns#INC-001 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/ns#INC-001">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/ns#Incident"/>
        <involvesDevice rdf:resource="http://www.owl-ontologies.com/ns#DEV-001"/>
        <incidentId>INC-001</incidentId>
        <severity>Critical</severity>
        <rdfs:comment xml:lang="en">Serious incident reported for HeartMate 3</rdfs:comment>
        <rdfs:label xml:lang="en">Incident 001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/ns#MAN-001 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/ns#MAN-001">
