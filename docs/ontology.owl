        <rdfs:label xml:lang="en">patient_sex</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/ns#probability -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/ns#probability">
